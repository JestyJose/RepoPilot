# Server Environment Variables (Template)
# Copy this file to server/.env and fill with your environment values.

# Server Port (Render/Railway sets this automatically via PORT)
PORT=5000

# Client origin(s) allowed by CORS
# For local development: http://localhost:5173
# For production: https://your-repopilot-frontend.vercel.app (supports comma-separated list)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development

# Optional: GitHub Personal Access Token to raise REST API rate limits from 60 to 5,000 requests/hr
# (Create a free classic token with NO special scopes needed for public repos)
# GITHUB_TOKEN=your_github_personal_access_token_here
