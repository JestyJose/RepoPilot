# Client Environment Variables (Template)
# Vite automatically exposes variables prefixed with VITE_ to the client bundle.
# Copy this file to client/.env and replace with your configuration.

# Backend API URL:
# - In local development: Leave blank or commented out (Vite dev server proxies /api to http://localhost:5000)
# - In production (e.g. Vercel): Set to your deployed backend URL (e.g. https://repopilot-api.onrender.com)
# VITE_API_URL=https://your-backend-api.onrender.com

# Supabase Authentication & PostgreSQL Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
